    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "wxt": "^0.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
